# Copy this file to .env for local development. Never commit .env.

# Port the server listens on. Render sets PORT itself in production.
PORT=3001

# Demo mode shortens the timers so a full alert fits in a short presentation:
#   - each guard is rung for 8 s instead of 20 s
#   - a camera can send a new signal after 5 s instead of 30 s
#   - /eye shows a "Simulate signal" button (also Shift+S) as a presentation backup
# Set to false for realistic timings.
DEMO_MODE=true

# Name shown on the dashboard. Overrides "Demo campus" from the seed file.
# CAMPUS_NAME=Echelon Institute of Technology

# ---------------------------------------------------------------------------
# Optional: phone calls through Twilio, as a second way to ring guards.
# Guards are always rung in the Guard app. When all four Twilio settings and
# GUARD_PHONES are set, each guard's phone is also called at the same time,
# and pressing 1 on the call confirms "I'm going". If anything is missing,
# phone calls stay off and nothing else changes.
#
# Trial accounts can only call numbers verified in the Twilio console, and
# calls to India need India enabled under Voice > Geo permissions.
# ---------------------------------------------------------------------------

# From the Twilio console, Account info.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=

# Your Twilio phone number, in international format.
# TWILIO_FROM_NUMBER=+15005550006

# The public https address of this server, so Twilio can send key presses back.
# On Render this is filled in automatically from RENDER_EXTERNAL_URL.
# For local testing, use an ngrok address: PUBLIC_URL=https://xxxx.ngrok-free.app
# PUBLIC_URL=

# Guard phone numbers, as guardId=number pairs separated by commas.
# Guard ids are in apps/server/src/seed/campus.json. Numbers are kept on the
# server only and are never sent to the browser.
# GUARD_PHONES=guard-1=+919800000001,guard-2=+919800000002,guard-3=+919800000003
